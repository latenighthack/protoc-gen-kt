package {{ package . }}

import com.latenighthack.ktbuf.proto.GrpcService
import com.latenighthack.ktbuf.net.RpcClient
import kotlinx.coroutines.flow.Flow
{{ range packageImports . -}}
import {{ . }}.*
{{ end -}}

{{- define "service" }}
interface {{ name . }}Service {
    companion object {
        val Descriptor = GrpcService.ServiceDescriptor(
            "{{ protoPackage . }}", "{{ name . }}", listOf(
                {{ range .Methods }}
                GrpcService.MethodDescriptor<{{ fullyQualifiedName .Input }}, {{ fullyQualifiedName .Output }}>(
                    "{{ originalName . }}",
                    {{ fullyQualifiedName .Input }}.Companion::readFrom,
                    {{ fullyQualifiedName .Output }}::writeTo,
                    {{ if .ClientStreaming }}true{{ else }}false{{ end }},
                    {{ if .ServerStreaming }}true{{ else }}false{{ end }}
                ),
                {{- end }}
            )
        )
    }
    {{ range .Methods }}
    {{ if .ServerStreaming }}{{ else }}suspend {{ end }}fun {{ name . }}(request: {{ if .ClientStreaming }}Flow<{{ fullyQualifiedName .Input }}>{{ else }}{{ fullyQualifiedName .Input }}{{- end }}{{ if .ServerStreaming }}, readyCallback: () -> Unit = {}{{- end }}): {{ if .ServerStreaming }}Flow<{{ fullyQualifiedName .Output }}>{{ else }}{{ fullyQualifiedName .Output }}{{- end }}
    {{- end }}
}

open class {{ name . }}ServiceRpc(rpc: RpcClient, private val additionalParams: (String, Any) -> Map<String, String> = { _, _ -> emptyMap() }): {{ name . }}Service, GrpcService(rpc, "{{ protoPackage . }}", "{{ name . }}") {
    {{- range .Methods }}
    override {{ if .ServerStreaming }}{{ else }}suspend {{ end }}fun {{ name . }}(request: {{ if .ClientStreaming }}Flow<{{ fullyQualifiedName .Input }}>{{ else }}{{ fullyQualifiedName .Input }}{{- end }}{{ if .ServerStreaming }}, readyCallback: () -> Unit{{- end }}): {{ if .ServerStreaming }}Flow<{{ fullyQualifiedName .Output }}>{{ else }}{{ fullyQualifiedName .Output }}{{- end }} = client{{ if .ClientStreaming }}Stream{{ else }}Unary{{- end }}Server{{ if .ServerStreaming }}Stream{{ else }}Unary{{- end }}("{{ .Name }}", request, {{ fullyQualifiedName .Input }}::writeTo, {{ fullyQualifiedName .Output }}.Companion::readFrom, { req -> additionalParams("{{ name .Input }}", req) } {{ if .ServerStreaming }}, readyCallback{{- end }})
    {{- end }}
}
{{- end }}
{{ range .Services }}{{ template "service" . }}{{ end -}}
